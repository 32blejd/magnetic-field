# Keep LF line endings in the repo and in the working copy on every OS
# (avoids "LF will be replaced by CRLF" warnings on Windows with core.autocrlf=true).
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files – never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
